{
  "name": "@factory/long-horizon-harness-lab",
  "version": "0.0.1",
  "private": true,
  "description": "Candidate-neutral TypeScript laboratory kernel for long-horizon autonomous harness qualification. Protocol only; no real agents are invoked.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx scripts/run-tests.mjs",
    "test:lab": "node --import tsx scripts/run-tests.mjs",
    "test:process": "node --import tsx --test --test-reporter=spec test/process/process-group.test.ts test/process/supervised-process.test.ts",
    "qualify:process-live": "FACTORY_STRICT_PROCESS_LIVE=1 node --import tsx --test --test-reporter=spec --test-timeout=30000 test/process/process-live-qualification.test.ts",
    "check:domain-purity": "node --import tsx --test --test-reporter=spec test/domain-purity.test.ts",
    "check:trust-boundary": "node --import tsx --test --test-reporter=spec test/trust-boundary.test.ts",
    "check:eof": "node --import tsx --test --test-reporter=spec test/ledger-evidence.test.ts",
    "fix:eof": "node scripts/normalize-eof.mjs",
    "normalize-eof": "node scripts/normalize-eof.mjs",
    "all": "npm run check:eof && npm run typecheck && npm run build && npm run test",
    "test:process:live": "node --import tsx --test --test-reporter=spec --test-timeout=30000 test/process/process-live-qualification.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
